# Copy to .env (gitignored) and adjust if you don't use the defaults
# baked into compose.yaml / src/wubwub/studio/config.py.

DATABASE_URL=postgresql://wubwub:wubwub@localhost:5432/wubwub

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=covers
MINIO_GIF_BUCKET=gifs
# Only needed if it differs from MINIO_ENDPOINT (e.g. reads happen from
# somewhere that can't resolve "localhost" the way this process can).
# MINIO_PUBLIC_ENDPOINT=http://localhost:9000
