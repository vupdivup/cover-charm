# Copy to .env (gitignored) and adjust if you don't use the defaults
# baked into compose.yaml / packages/album-store/src/album_store/config.py.

DATABASE_URL=postgresql://cover_art:cover_art@localhost:5432/cover_art

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=covers
# Only needed if it differs from MINIO_ENDPOINT (e.g. reads happen from
# somewhere that can't resolve "localhost" the way this process can).
# MINIO_PUBLIC_ENDPOINT=http://localhost:9000
